    <parent link="BODY"/>
    <child link="F_B_L_Link"/>
    <axis xyz="0 -1 0"/>
  </joint>

  <link name="F_F_L_Link">
    <inertial>
      <origin xyz="4.15812041199004E-06 -0.0387764089921866 2.34397188730168E-05" rpy="0 0 0"/>
      <mass value="0.524145303423396"/>
      <inertia ixx="0.000688541696255438" ixy="4.27348346512295E-10" ixz="1.07231841854522E-08" iyy="0.00122439446607239" iyz="8.19227106083357E-08" izz="0.000688691120818141"/>
    </inertial>
    <visual>

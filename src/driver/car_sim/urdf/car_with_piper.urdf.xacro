    <child link="link6"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.0943951" upper="2.0943951" effort="100" velocity="5"/>
  </joint>

  <!-- ================================================================== -->
  <!-- GRIPPER (from piper_with_gripper_description.xacro)                -->
  <!-- ================================================================== -->

  <link name="flange_link">
    <inertial>
      <origin xyz="1.151691e-03 0.782428e-03 4.798051e-03" rpy="0 0 0"/>
      <mass value="0.04"/>
      <inertia ixx="9.935389e-06" ixy="0.0" ixz="0.0" iyy="10.508003e-06" iyz="0.0" izz="19.652873e-06"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://car_sim/meshes/piper/meshes/dae/flange.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://car_sim/meshes/piper/meshes/flange.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="flange_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="link6"/>
    <child link="flange_link"/>
  </joint>

  <link name="gripper_base">
    <inertial>
      <origin xyz="-0.000183807162235591 8.05033155577911E-05 0.0321436689908876" rpy="0 0 0"/>
      <mass value="0.45"/>
      <inertia ixx="0.00092934" ixy="0.00000034" ixz="-0.00000738" iyy="0.00071447" iyz="0.00000005" izz="0.00039442"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://car_sim/meshes/piper/meshes/dae/gripper_base.dae"/>

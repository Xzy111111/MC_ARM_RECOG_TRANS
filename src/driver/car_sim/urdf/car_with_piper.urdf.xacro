    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://car_sim/meshes/piper/meshes/gripper_base.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="gripper_base_joint" type="fixed">
    <origin xyz="0 0 0.0045" rpy="0 0 0"/>
    <parent link="flange_link"/>
    <child link="gripper_base"/>
  </joint>

  <link name="gripper_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="gripper" type="prismatic">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="gripper_base"/>
    <child link="gripper_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="0.1" effort="10" velocity="3"/>
  </joint>

  <link name="gripper_link1">
    <inertial>
      <origin xyz="0.00065123185041968 -0.0491929869131989 0.00972258769184025" rpy="0 0 0"/>
      <mass value="0.025"/>
      <inertia ixx="0.00007371" ixy="-0.00000113" ixz="0.00000021" iyy="0.00000781" iyz="-0.00001372" izz="0.0000747"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>

      </geometry>
    </collision>
  </link>

  <joint name="F_F_R" type="continuous">
    <origin xyz="0.15264 -0.16974 -0.075972" rpy="0 0 0"/>
    <parent link="BODY"/>
    <child link="F_F_R_Link"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="mid_Link">
    <inertial>
      <origin xyz="-0.000199574115905488 -6.35009226230681E-06 -0.0174674074223493" rpy="0 0 0"/>
      <mass value="1.10672092820322"/>
      <inertia ixx="0.000326022185952641" ixy="-4.30083905768617E-08" ixz="2.38151317788481E-06" iyy="0.000351603059138939" iyz="-3.50267298324671E-09" izz="0.000536638419995748"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>

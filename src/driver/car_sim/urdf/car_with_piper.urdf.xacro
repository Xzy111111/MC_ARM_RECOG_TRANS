    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://car_sim/meshes/F_B_R_Link.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://car_sim/meshes/F_B_R_Link.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="F_B_R" type="continuous">
    <origin xyz="-0.16764 -0.16973 -0.075972" rpy="0 0 3.1416"/>
    <parent link="BODY"/>
    <child link="F_B_R_Link"/>
    <axis xyz="0 -1 0"/>
  </joint>

  <link name="F_B_L_Link">
    <inertial>
      <origin xyz="-4.15299885625497E-06 -0.0387766610714727 2.34389243685268E-05" rpy="0 0 0"/>
      <mass value="0.524142277597696"/>
      <inertia ixx="0.00068853758424145" ixy="-3.92881396763585E-10" ixz="-1.06939732529201E-08" iyy="0.0012243872904858" iyz="8.19284767318812E-08" izz="0.000688687134517085"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>

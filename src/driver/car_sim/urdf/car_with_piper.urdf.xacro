<?xml version="1.0" encoding="utf-8"?>
<!--
  Combined robot: car chassis (car_sim) + piper arm with gripper
  - Arm base (base_link) is mounted at the chassis BODY origin
  - Meshes are referenced via package:// paths (ROS convention)
    package://car_sim/meshes/  ->  car_sim/meshes/
    package://car_sim/meshes/piper/meshes/  ->  piper/meshes/
-->
<robot name="car_with_piper" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================================================================== -->
  <!-- CAR CHASSIS (from car_sim/urdf/car_sim.urdf)                      -->
  <!-- ================================================================== -->

  <link name="BODY">
    <inertial>
      <origin xyz="-0.00259004720498476 0.00067655820357232 -0.0538140096287424" rpy="0 0 0"/>
      <mass value="2.27568516297066"/>
      <inertia ixx="0.0059562120597256" ixy="1.31889223961593E-06" ixz="2.51283201679577E-06" iyy="0.00735196152742861" iyz="-4.0563085068629E-08" izz="0.0127389179090798"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://car_sim/meshes/BODY.STL"/>
      </geometry>
      <material name="">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://car_sim/meshes/BODY.STL"/>
      </geometry>
    </collision>
  </link>

  <link name="F_B_R_Link">
    <inertial>
      <origin xyz="4.15811247411746E-06 -0.0387764090043724 2.34397195175429E-05" rpy="0 0 0"/>
      <mass value="0.524145303230556"/>

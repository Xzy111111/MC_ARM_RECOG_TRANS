        <color rgba="0.615686274509804 0.643137254901961 0.674509803921569 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://car_sim/meshes/mid_Link.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="mid360" type="fixed">
    <origin xyz="0.1325 0 0.010499" rpy="0 0 3.1416"/>
    <parent link="BODY"/>
    <child link="mid_Link"/>
    <axis xyz="0 0 0"/>
  </joint>

  <!-- ================================================================== -->
  <!-- CONNECTION: Mount piper arm on car chassis                         -->
  <!--   base_link origin aligns with BODY origin (xyz=0 0 0, rpy=0 0 0) -->
  <!-- ================================================================== -->

  <joint name="body_to_base_link" type="fixed">
    <parent link="BODY"/>
    <child link="base_link"/>
    <origin xyz="0 0 -0.004" rpy="0 0 0"/>
  </joint>

  <!-- ================================================================== -->
  <!-- PIPER ARM (from piper_description.urdf                            -->
  <!--   All links are identical to the original except:                  -->
  <!--    - Removed <link name="world"/>                                  -->
  <!--    - Removed <joint name="world_to_base_link"/>                    -->
  <!--    - base_link is now child of BODY via body_to_base_link above    -->
  <!-- ================================================================== -->

  <link name="base_link">
    <inertial>
      <origin xyz="-0.00473641164191482 2.56829134630247E-05 0.041451518036016" rpy="0 0 0"/>
      <mass value="1.02"/>
      <inertia ixx="0.00267433" ixy="-0.00000073" ixz="-0.00017389" iyy="0.00282612" iyz="0.0000004" izz="0.00089624"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://car_sim/meshes/piper/meshes/dae/base_link.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://car_sim/meshes/piper/meshes/base_link.stl"/>
      </geometry>
    </collision>
  </link>

  <link name="link1">
    <inertial>
      <origin xyz="0.00032 -0.00041 -0.00348" rpy="0 0 0"/>
      <mass value="0.71"/>
      <inertia ixx="0.00050027" ixy="0.00000078" ixz="0.00000626" iyy="0.00040879" iyz="0.00000462" izz="0.00045802"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://car_sim/meshes/piper/meshes/dae/link1.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://car_sim/meshes/piper/meshes/link1.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint1" type="revolute">
    <origin xyz="0 0 0.123" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="link1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.6179938" upper="2.6179938" effort="100" velocity="5"/>
  </joint>

  <link name="link2">
    <inertial>
      <origin xyz="0.21852 -0.00861 0.00126" rpy="0 0 0"/>
      <mass value="1.16"/>
      <inertia ixx="0.00111915" ixy="0.00182916" ixz="0.00019233" iyy="0.06763251" iyz="0.00000767" izz="0.067559"/>

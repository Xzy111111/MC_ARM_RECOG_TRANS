  <joint name="joint3" type="revolute">
    <origin xyz="0.28503 0 0" rpy="0 0 -1.7938494"/>
    <parent link="link2"/>
    <child link="link3"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.9670597" upper="0" effort="100" velocity="5"/>
  </joint>

  <link name="link4">

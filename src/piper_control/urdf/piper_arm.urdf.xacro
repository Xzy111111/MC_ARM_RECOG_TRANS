<?xml version="1.0" encoding="utf-8"?>
<!--
  Piper 6-axis arm, root = base_link (no world).
  Mesh + joint origins copied from official agx_arm_description piper URDF.
  Planning root is base_link so MoveIt plans in the navigation frame
  (map->odom->base_link, published by small_point_lio) without TF conflicts.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="piper_arm">

  <xacro:arg name="tcp_offset_xyz" default="0 0 0" />
  <xacro:arg name="tcp_offset_rpy" default="0 0 0" />
  <xacro:arg name="initial_positions_file" default="../config/initial_positions.yaml" />

  <!-- ==================== BASE ==================== -->
  <link name="base_link">
    <inertial>
      <origin xyz="-0.00473641164191482 2.56829134630247E-05 0.041451518036016" rpy="0 0 0"/>
      <mass value="1.02" />
      <inertia ixx="0.00267433" ixy="-0.00000073" ixz="-0.00017389" iyy="0.00282612" iyz="0.0000004" izz="0.00089624"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://agx_arm_description/agx_arm_urdf/piper/meshes/dae/base_link.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://agx_arm_description/agx_arm_urdf/piper/meshes/base_link.stl"/>
      </geometry>
    </collision>
  </link>

  <!-- ==================== LINK1 ==================== -->
  <link name="link1">
    <inertial>
      <origin xyz="0.00032 -0.00041 -0.00348" rpy="0 0 0"/>
      <mass value="0.71"/>
      <inertia ixx="0.00050027" ixy="0.00000078" ixz="0.00000626" iyy="0.00040879" iyz="0.00000462" izz="0.00045802"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://agx_arm_description/agx_arm_urdf/piper/meshes/dae/link1.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://agx_arm_description/agx_arm_urdf/piper/meshes/link1.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint1" type="revolute">
    <origin xyz="0 0 0.123" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="link1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.6179938" upper="2.6179938" effort="100" velocity="5"/>
  </joint>

  <!-- ==================== LINK2 ==================== -->
  <link name="link2">
    <inertial>
      <origin xyz="0.21852 -0.00861 0.00126" rpy="0 0 0"/>
      <mass value="1.16"/>
      <inertia ixx="0.00111915" ixy="0.00182916" ixz="0.00019233" iyy="0.06763251" iyz="0.00000767" izz="0.067559"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://agx_arm_description/agx_arm_urdf/piper/meshes/dae/link2.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://agx_arm_description/agx_arm_urdf/piper/meshes/link2.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint2" type="revolute">
    <origin xyz="0 0 0" rpy="1.5707963 -0.1357866 -3.1415926"/>
    <parent link="link1"/>
    <child link="link2"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="3.1415926" effort="100" velocity="5"/>
  </joint>

  <!-- ==================== LINK3 ==================== -->
  <link name="link3">
    <inertial>
      <origin xyz="-0.01999 -0.14808 -0.00053" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.01347608" ixy="0.00161034" ixz="0.00000066" iyy="0.00046377" iyz="0.00000162" izz="0.01363321"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://agx_arm_description/agx_arm_urdf/piper/meshes/dae/link3.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://agx_arm_description/agx_arm_urdf/piper/meshes/link3.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint3" type="revolute">
    <origin xyz="0.28503 0 0" rpy="0 0 -1.7938494"/>
    <parent link="link2"/>
    <child link="link3"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.9670597" upper="0" effort="100" velocity="5"/>
  </joint>

  <!-- ==================== LINK4 ==================== -->
  <link name="link4">
    <inertial>
      <origin xyz="0.00013 -0.00076 -0.00394" rpy="0 0 0"/>
      <mass value="0.38"/>
      <inertia ixx="0.00017844" ixy="0.00000062" ixz="0.00000067" iyy="0.00018914" iyz="0.00000408" izz="0.00014613"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://agx_arm_description/agx_arm_urdf/piper/meshes/dae/link4.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://agx_arm_description/agx_arm_urdf/piper/meshes/link4.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint4" type="revolute">
    <origin xyz="-0.02198 -0.25075 0" rpy="1.5707963 0 0"/>
    <parent link="link3"/>
    <child link="link4"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.7453292" upper="1.7453292" effort="100" velocity="5"/>
  </joint>

  <!-- ==================== LINK5 ==================== -->
  <link name="link5">
    <inertial>
      <origin xyz="0.00018 -0.06104 -0.00227" rpy="0 0 0"/>
      <mass value="0.383"/>
      <inertia ixx="0.00172318" ixy="0.00000259" ixz="0.00000010" iyy="0.00017936" iyz="0.00000990" izz="0.00171172"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://agx_arm_description/agx_arm_urdf/piper/meshes/dae/link5.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://agx_arm_description/agx_arm_urdf/piper/meshes/link5.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint5" type="revolute">
    <origin xyz="0 0 0" rpy="-1.5707963 0 0"/>
    <parent link="link4"/>
    <child link="link5"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.2217304" upper="1.2217304" effort="100" velocity="5"/>
  </joint>

  <!-- ==================== LINK6 ==================== -->
  <link name="link6">
    <inertial>
      <origin xyz="-0.00003 0.00006 -0.002" rpy="0 0 0"/>
      <mass value="0.007"/>
      <inertia ixx="0.00152112" ixy="0.00000202" ixz="0.00000261" iyy="0.00138626" iyz="0.00000002" izz="0.00031152"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://agx_arm_description/agx_arm_urdf/piper/meshes/dae/link6.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://agx_arm_description/agx_arm_urdf/piper/meshes/link6.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint6" type="revolute">
    <origin xyz="8.8259E-05 -0.091 0" rpy="1.5707963 0 0"/>
    <parent link="link5"/>
    <child link="link6"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.0943951" upper="2.0943951" effort="100" velocity="5"/>
  </joint>

  <!-- ==================== FLANGE (official) ==================== -->
  <link name="flange_link">
    <inertial>
      <origin xyz="1.151691e-03 0.782428e-03 4.798051e-03" rpy="0 0 0"/>
      <mass value="0.04"/>
      <inertia ixx="9.935389e-06" ixy="0.0" ixz="0.0" iyy="10.508003e-06" iyz="0.0" izz="19.652873e-06"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://agx_arm_description/agx_arm_urdf/piper/meshes/dae/flange.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://agx_arm_description/agx_arm_urdf/piper/meshes/flange.stl"/>
      </geometry>
    </collision>
  </link>
  <joint name="flange_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="link6"/>
    <child link="flange_link"/>
  </joint>

  <!-- ==================== GRIPPER BASE (official) ==================== -->
  <link name="gripper_base">
    <inertial>
      <origin xyz="-0.000183807162235591 8.05033155577911E-05 0.0321436689908876" rpy="0 0 0"/>
      <mass value="0.45"/>
      <inertia ixx="0.00092934" ixy="0.00000034" ixz="-0.00000738" iyy="0.00071447" iyz="0.00000005" izz="0.00039442"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://agx_arm_description/agx_arm_urdf/piper/meshes/dae/gripper_base.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://agx_arm_description/agx_arm_urdf/piper/meshes/gripper_base.stl"/>
      </geometry>
    </collision>
  </link>
  <joint name="gripper_base_joint" type="fixed">
    <origin xyz="0 0 0.0045" rpy="0 0 0"/>
    <parent link="flange_link"/>
    <child link="gripper_base"/>
  </joint>

  <!-- ==================== GRIPPER FINGERS (official) ==================== -->
  <link name="gripper_link"/>
  <joint name="gripper" type="prismatic">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="gripper_base"/>
    <child link="gripper_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="0.1" effort="10" velocity="3"/>
  </joint>

  <link name="gripper_link1">
    <inertial>
      <origin xyz="0.00065123185041968 -0.0491929869131989 0.00972258769184025" rpy="0 0 0"/>
      <mass value="0.025"/>
      <inertia ixx="0.00007371" ixy="-0.00000113" ixz="0.00000021" iyy="0.00000781" iyz="-0.00001372" izz="0.0000747"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://agx_arm_description/agx_arm_urdf/piper/meshes/dae/gripper_link1.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://agx_arm_description/agx_arm_urdf/piper/meshes/gripper_link1.stl"/>
      </geometry>
    </collision>
  </link>
  <joint name="gripper_joint1" type="prismatic">
    <origin xyz="0 0 0.138" rpy="1.5707963 0 0"/>
    <parent link="gripper_base"/>
    <child link="gripper_link1"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="0.05" effort="10" velocity="3"/>
    <mimic joint="gripper" multiplier="0.5" offset="0.0"/>
  </joint>

  <link name="gripper_link2">
    <inertial>
      <origin xyz="0.00065123185041968 -0.0491929869131989 0.00972258769184025" rpy="0 0 0"/>
      <mass value="0.025"/>
      <inertia ixx="0.00007371" ixy="-0.00000113" ixz="0.00000021" iyy="0.00000781" iyz="-0.00001372" izz="0.0000747"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://agx_arm_description/agx_arm_urdf/piper/meshes/dae/gripper_link2.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://agx_arm_description/agx_arm_urdf/piper/meshes/gripper_link2.stl"/>
      </geometry>
    </collision>
  </link>
  <joint name="gripper_joint2" type="prismatic">
    <origin xyz="0 0 0.138" rpy="1.5707963 0 -3.1415926"/>
    <parent link="gripper_base"/>
    <child link="gripper_link2"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-0.05" upper="0" effort="10" velocity="3"/>
    <mimic joint="gripper" multiplier="-0.5" offset="0.0"/>
  </joint>

  <!-- ==================== GRASP CENTER (MoveIt planning target) ==================== -->
  <!-- gripper_tcp: 固定虚拟 link, 位于两指张开平面中心 (gripper_base +z 0.138m, x=y=0) -->
  <link name="gripper_tcp" />
  <joint name="gripper_tcp_joint" type="fixed">
    <parent link="gripper_base" />
    <child link="gripper_tcp" />
    <origin xyz="0 0 0.138" rpy="0 0 0" />
  </joint>

  <!-- tcp_link: 保留作为法兰参考 (link6 原点, 受 tcp_offset 控制), 不再作为 MoveIt arm tip -->
  <link name="tcp_link" />
  <joint name="tcp_joint" type="fixed">
    <parent link="link6" />
    <child link="tcp_link" />
    <origin xyz="$(arg tcp_offset_xyz)" rpy="$(arg tcp_offset_rpy)" />
  </joint>

  <!-- ==================== ros2_control (mock hardware) ==================== -->
  <xacro:property name="initial_positions" value="${xacro.load_yaml('$(arg initial_positions_file)')['initial_positions']}" />

  <ros2_control name="FakeSystem" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
    </hardware>
    <joint name="joint1">
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">${initial_positions['joint1']}</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <joint name="joint2">
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">${initial_positions['joint2']}</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <joint name="joint3">
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">${initial_positions['joint3']}</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <joint name="joint4">
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">${initial_positions['joint4']}</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <joint name="joint5">
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">${initial_positions['joint5']}</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <joint name="joint6">
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">${initial_positions['joint6']}</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <!-- gripper: mock 接口, 使 joint_state_broadcaster 发布 gripper 关节值 -->
    <joint name="gripper">
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">${initial_positions['gripper']}</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
  </ros2_control>
</robot>

      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://car_sim/meshes/F_F_L_Link.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="F_F_L" type="continuous">
    <origin xyz="0.15264 0.16974 -0.075972" rpy="0 0 0"/>
    <parent link="BODY"/>
    <child link="F_F_L_Link"/>
    <axis xyz="0 -1 0"/>
  </joint>

  <link name="F_F_R_Link">
    <inertial>
      <origin xyz="4.15299265113522E-06 0.0387766610527853 2.34388943382846E-05" rpy="0 0 0"/>
      <mass value="0.524142276253491"/>
      <inertia ixx="0.000688537583988537" ixy="-3.92872414056818E-10" ixz="1.06939579529851E-08" iyy="0.00122438729047445" iyz="-8.19284680795588E-08" izz="0.00068868713426558"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://car_sim/meshes/F_F_R_Link.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
